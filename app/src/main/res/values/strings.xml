    <!-- Roadmap & Vision Screen -->
    <string name="roadmap_title">Roadmap &amp; Vision</string>
    <string name="roadmap_subtitle">Transparent milestone tracking and future ecosystem architecture.</string>
    <string name="roadmap_section_completed">Completed Milestones (V1.0 Baseline)</string>
    <string name="roadmap_section_active">Active Development (V1.1 - V1.5)</string>
    <string name="roadmap_section_future">Future Vision (V2.0 Ecosystem)</string>

    <string name="roadmap_item_core_engine_title">Modular Accessibility Interceptor Pipeline</string>
    <string name="roadmap_item_core_engine_desc">Chain of responsibility architecture separating App Blocker, Reels Filter, Web Blocker, and Focus Mode with optimized node traversal.</string>
    <string name="roadmap_item_offline_licensing_title">Offline NIST P-256 ECDSA Licensing</string>
    <string name="roadmap_item_offline_licensing_desc">100% offline cryptographic public key verification for Pro licenses on Google Play, F-Droid, and sideloaded builds.</string>
    <string name="roadmap_item_anti_uninstall_title">Hardened Anti-Uninstall &amp; Tamper Defense</string>
    <string name="roadmap_item_anti_uninstall_desc">Multi-vector interception protecting Device Admin, Google Play uninstallation, and OEM settings with Home exit routing.</string>
    <string name="roadmap_item_triple_pin_title">Triple-Layer PIN Security Architecture</string>
    <string name="roadmap_item_triple_pin_desc">Granular PIN barriers separating App Lock, Bypass Override, and Per-Rule modification protection with PBKDF2 hashing.</string>
    <string name="roadmap_item_local_analytics_title">On-Device Screen Time &amp; Widget Suite</string>
    <string name="roadmap_item_local_analytics_desc">Local usage analytics, doomscroll trackers, and glanceable Material 3 home screen widgets with zero telemetry.</string>

    <string name="roadmap_item_windows_bg_title">Windows Elevated Background Service</string>
    <string name="roadmap_item_windows_bg_desc">System-level Windows service managing UAC-free network hosts resolution and desktop process monitoring.</string>
    <string name="roadmap_item_dns_sinkhole_title">Local VPN DNS Sinkhole Filter</string>
    <string name="roadmap_item_dns_sinkhole_desc">On-device VPN packet filtering engine for network-wide tracking and ad/adult domain suppression across all apps.</string>
    <string name="roadmap_item_bulk_lists_title">Advanced Bulk List Import &amp; Export</string>
    <string name="roadmap_item_bulk_lists_desc">Structured CSV/TXT import and export engine for custom Keyword and Website blocklists.</string>

    <string name="roadmap_item_vision_blur_title">Real-Time Mobile NPU Vision Blur Engine</string>
    <string name="roadmap_item_vision_blur_desc">On-device screen frame scanning and AI content blurring powered by LiteRT / Mobile NPU (AmnGaze integration).</string>
    <string name="roadmap_item_cloud_sync_title">Multi-Platform Cloud Policy Sync</string>
    <string name="roadmap_item_cloud_sync_desc">Optional end-to-end encrypted rule synchronization across Android, Windows Desktop, and Web Console.</string>

    <!-- Strict Premium Scope & Boundaries -->
